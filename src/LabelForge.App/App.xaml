<Application x:Class="LabelForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
         <SolidColorBrush x:Key="AppBackground" Color="#F3F4F6"/>
         <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF"/>
         <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
         <SolidColorBrush x:Key="PrimaryText" Color="#111827"/>
         <SolidColorBrush x:Key="SecondaryText" Color="#6B7280"/>
         <SolidColorBrush x:Key="AccentColor" Color="#2563EB"/>
    </Application.Resources>
</Application>
